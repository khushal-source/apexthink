{
  "name": "apex-think",
  "version": "1.0.0",
  "description": "Apex Think – AI Repository Intelligence",
  "main": "backend/app.js",
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node backend/app.js",
    "client": "npm run dev --prefix frontend",
    "postinstall": "cd frontend && npm install",
    "dev": "nodemon backend/app.js"
  },
  "keywords": [
    "github",
    "code-analysis",
    "ai",
    "dependency-graph",
    "gemini"
  ],
  "author": "CodeMap AI Team",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.103.3",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.9"
  }
}
